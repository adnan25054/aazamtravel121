# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# INDIAN_RAIL_API_KEY: Optional API key for Indian Rail API (http://indianrailapi.com)
# Used for live train running status, PNR verification, and station autocomplete.
INDIAN_RAIL_API_KEY=""

# RAILRADAR_API_KEY: Optional API key for RailRadar API (https://api.railradar.in)
# Used for Train Schedule, Route Timetable, halts, and coach positions.
# NEWSAPI_KEY: Optional API key for NewsAPI (https://newsapi.org)
# Used for live Indian Railways, travel advisories, aviation and tourism news updates.
NEWSAPI_KEY="9001e49738f048c3b026a1b48369c424"

# AVIATIONSTACK_API_KEY: Aviationstack API key for live flight tracking (https://aviationstack.com)
# Used for live flight tracking, status, schedules, airport departures and arrivals.
AVIATIONSTACK_API_KEY="04b329aff972cc2425c23a43f785f837"

# RAILKIT_API_KEY: API Key for RailKit (https://api.railkit.in)
# Used for Live Train Running Status (NTES Indian Railways, real-time GPS tracking, delays, station platforms).
RAILKIT_API_KEY="railkit_c24738ea5feef65279b390dbe12917a6efddf5baaeb19773"

# RAPIDAPI_KEY: Optional API Key for RapidAPI (https://rapidapi.com)
# Used for secondary fallback live status verification.
RAPIDAPI_KEY="5ec299b47amshdc60e18c9b596bdp1305f3jsn25dbfd16a9c8"
